# Copy to .env.local and fill in.

# PocketBase URL. Used by server code AND the browser SDK (must be reachable
# from the user's browser). In production use your public https URL.
NEXT_PUBLIC_PB_URL=http://127.0.0.1:8090

# Superuser credentials — server-only. The phone API routes authenticate as
# this superuser to resolve API keys and read/write messages. Must match the
# superuser you create at deploy time (`pocketbase superuser upsert ...`).
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me-to-a-strong-password

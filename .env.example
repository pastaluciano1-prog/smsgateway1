# Copy to .env before running `docker compose up`.

# Public URL where users' BROWSERS reach PocketBase (baked into the panel build).
# Local compose: http://localhost:8090
# Production: your public PocketBase URL, e.g. https://pb.yourdomain.com
NEXT_PUBLIC_PB_URL=http://localhost:8090

# Superuser — created on first boot and used by the panel's phone API routes.
# Use a strong password in production.
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me-to-a-strong-password
